NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
DATABASE_URL=postgresql://practice:practice@localhost:5432/practice?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=practice-audio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
PUBLIC_API_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
MAX_MEDIA_SIZE_MB=200
MAX_MEDIA_PER_SESSION=20
MAX_SESSION_TOTAL_MB=1024
UPLOAD_URL_TTL_SECONDS=900
PLAYBACK_URL_TTL_SECONDS=300
METRICS_ENABLED=true
LOG_LEVEL=info

# Worker：音频探测超时（毫秒）、自动重试与 PROCESSING 卡死恢复
WORKER_CONCURRENCY=3
DOWNLOAD_TOTAL_TIMEOUT_MS=60000
DOWNLOAD_IDLE_TIMEOUT_MS=15000
PROBE_TIMEOUT_MS=30000
PEAKS_TIMEOUT_MS=90000
# 可重试错误的最大尝试次数；永久错误（如无音轨、文件损坏）立即失败不重试
PROBE_MAX_ATTEMPTS=4
# PROCESSING 超过该时长未更新视为崩溃遗留，重启/定时扫描会重新投递
STALE_PROCESSING_MS=600000
STALLED_INTERVAL_MS=30000
MAX_STALLED_COUNT=3
